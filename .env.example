# ─── EdgeAI Micro-Provider ───
# Copie para .env e ajuste conforme necessário.

# API Key para autenticação (opcional — se vazio, aceita qualquer request)
API_KEY=sk-edge-dev-local

# Servidor
HOST=0.0.0.0
PORT=9880

# Diretório onde ficam os modelos .gguf
MODELS_DIR=~/.edge_ai_models

# Logging
LOG_LEVEL=info

# ─── Hardware Limits ───
# Percentual máximo de RAM antes de rejeitar novas inferências
MAX_RAM_PERCENT=85
# Percentual máximo de CPU antes de rejeitar novas inferências
MAX_CPU_PERCENT=90
# Número máximo de inferências simultâneas (fallback se hardware OK)
MAX_CONCURRENT_INFERENCES=2

# ─── GPU ───
# auto = detecta automaticamente | none = força CPU | <número> = layers na GPU
GPU_MODE=auto
